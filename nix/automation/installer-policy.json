{
  "alwaysRelevantPatterns": [
    ".github/workflows/ci.yml"
  ],
  "ignoredChangePatterns": [
    "AGENTS.md",
    "LICENSE",
    "VERSION",
    "README*",
    "CHANGELOG*",
    "devenv.lock",
    "devenv.nix",
    "devenv.yaml",
    "secretspec.toml",
    "docs/*",
    "packer/*",
    "tests/*",
    "modules/outputs/checks.nix",
    "modules/outputs/dev-shells.nix",
    "nix/checks/*",
    "nix/devenv.nix",
    "nix/automation/github/*",
    ".github/*"
  ]
}
